<?xml version="1.0" encoding="utf-8"?>
<!-- 小部件任务列表项：参照桌面端 TaskItem 卡片（复选框 + 标题 + 文件夹 + 截止徽章） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_item_root"
    android:layout_width="match_parent"
    android:layout_height="68dp"
    android:orientation="vertical"
    android:background="@drawable/widget_tap_feedback"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <!-- 行1：复选框 + 标题 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/item_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_task_normal" />

        <TextView
            android:id="@+id/item_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 行2：文件夹 + 截止徽章（5 个徽章预定义，Factory 按等级切可见性） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/item_folder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_folder"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#2DA04E"
            android:textSize="11sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- 琥珀（已逾期） -->
        <TextView
            android:id="@+id/item_dl_overdue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#E49E00"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_overdue"
            android:visibility="gone" />

        <!-- 红（1天内） -->
        <TextView
            android:id="@+id/item_dl_red"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FF3333"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_red"
            android:visibility="gone" />

        <!-- 橙红（1-3天） -->
        <TextView
            android:id="@+id/item_dl_orange"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FF5A2E"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_orange"
            android:visibility="gone" />

        <!-- 橙（3-7天） -->
        <TextView
            android:id="@+id/item_dl_amber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#FF9500"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_amber"
            android:visibility="gone" />

        <!-- 黑（7天以上） -->
        <TextView
            android:id="@+id/item_dl_dark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#1D1D1F"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_dark"
            android:visibility="gone" />

        <!-- 灰（仅开始日期 / 无截止） -->
        <TextView
            android:id="@+id/item_dl_gray"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:textColor="#6E6E73"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_badge_dark"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
