<?xml version="1.0" encoding="utf-8"?>
<!-- 标准 Android 滚动版：ListView 由 RemoteViewsService 提供数据；鸿蒙兼容版仍使用 task_widget.xml。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/widget_brand_dot"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/scroll_widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_scroll_title"
            android:textColor="#1D1D1F"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/scroll_btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_tap_feedback"
            android:clickable="true"
            android:contentDescription="@string/widget_refresh"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/scroll_btn_add"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_tap_feedback"
            android:clickable="true"
            android:contentDescription="@string/widget_add"
            android:focusable="true"
            android:padding="5dp"
            android:src="@drawable/ic_add_circle" />
    </LinearLayout>

    <ListView
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:fadeScrollbars="true"
        android:paddingTop="2dp"
        android:paddingBottom="4dp"
        android:scrollbars="vertical" />

    <TextView
        android:id="@+id/scroll_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="#8E8E93"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
