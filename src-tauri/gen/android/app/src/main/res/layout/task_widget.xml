<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小部件布局：顶部控制栏 + 任务区（静态行 × 6，weight 拉伸填满高度）。
     重要（真机定案，华为鸿蒙 5.x）：
     1. 集合视图（ListView）点击在鸿蒙不可用 → 用静态行 + 每项独立 setOnClickPendingIntent；
     2. ScrollView 不在 RemoteViews 官方支持清单，鸿蒙渲染报"问题加载小工具"→ 不能用，
        小部件平台不支持任意内容滚动（只能靠行数上限 + 高度自适应）。
     行数上限 6：weight 等分高度，最小尺寸下每行 ≥18dp 图标高度。
     视觉规范：与应用端一致（品牌蓝 #007AFF / 分隔线半透明灰 / 圆角药丸标签）；
     按钮一律用矢量图标（ImageView）而非文字符号，避免不同 ROM 字形渲染差异。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 顶部控制栏：品牌点 + 标题 + 待办计数 + 刷新 / 新增；外观设置移入应用，减少首屏干扰 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="7dp"
            android:background="@drawable/widget_brand_dot"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="@string/widget_title"
            android:textColor="#1D1D1F"
            android:textSize="15.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_pill_brand"
            android:maxLines="1"
            android:paddingStart="7dp"
            android:paddingTop="1dp"
            android:paddingEnd="7dp"
            android:paddingBottom="1dp"
            android:textColor="#007AFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:orientation="horizontal" />

        <ImageView
            android:id="@+id/btn_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_tap_feedback"
            android:clickable="true"
            android:contentDescription="@string/widget_refresh"
            android:focusable="true"
            android:padding="7dp"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/btn_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_tap_feedback"
            android:clickable="true"
            android:contentDescription="@string/widget_add"
            android:focusable="true"
            android:padding="2dp"
            android:src="@drawable/ic_add_circle" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="10dp"
        android:background="#1A8E8E93" />

    <!-- 保留任务解析输入入口：点击后打开独立输入页，支持自然语言日期解析。 -->
    <LinearLayout
        android:id="@+id/btn_quick_add"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_input_pill"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_plus" />

        <TextView
            android:id="@+id/btn_quick_add_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/widget_task_quick_add"
            android:textColor="#8E8E93"
            android:textSize="12.5sp" />
    </LinearLayout>

    <!-- ===== 任务行 × 6（weight 等分填满剩余高度；小尺寸由 Provider 隐藏多余行） ===== -->
    <LinearLayout
        android:id="@+id/slot_1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tap_feedback"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <ImageView
            android:id="@+id/item_check_1"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_task_normal" />

        <TextView
            android:id="@+id/item_title_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_dl_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slot_2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tap_feedback"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <ImageView
            android:id="@+id/item_check_2"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_task_normal" />

        <TextView
            android:id="@+id/item_title_2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_dl_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slot_3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tap_feedback"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <ImageView
            android:id="@+id/item_check_3"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_task_normal" />

        <TextView
            android:id="@+id/item_title_3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_dl_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slot_4"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tap_feedback"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <ImageView
            android:id="@+id/item_check_4"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_task_normal" />

        <TextView
            android:id="@+id/item_title_4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_dl_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slot_5"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tap_feedback"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <ImageView
            android:id="@+id/item_check_5"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_task_normal" />

        <TextView
            android:id="@+id/item_title_5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_dl_5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/slot_6"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_tap_feedback"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="3dp"
        android:paddingEnd="3dp">

        <ImageView
            android:id="@+id/item_check_6"
            android:layout_width="19dp"
            android:layout_height="19dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_task_normal" />

        <TextView
            android:id="@+id/item_title_6"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#1D1D1F"
            android:textSize="13.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/item_dl_6"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_pill"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:textColor="#8E8E93"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 空列表占位 -->
    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="#8E8E93"
        android:textSize="12sp" />

    <!-- 上/下翻页（同一小部件通过偏移分页展示更多任务；仅多页时显示） -->
    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btn_up"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_tap_feedback"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="3dp"
            android:src="@drawable/ic_chevron_up" />

        <TextView
            android:id="@+id/widget_page"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:maxLines="1"
            android:text="第1/1页"
            android:textColor="#8E8E93"
            android:textSize="10.5sp" />

        <ImageView
            android:id="@+id/btn_down"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_tap_feedback"
            android:clickable="true"
            android:contentDescription="@null"
            android:focusable="true"
            android:padding="3dp"
            android:src="@drawable/ic_chevron_down" />
    </LinearLayout>
</LinearLayout>
